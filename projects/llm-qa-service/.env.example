# ============ LLM 服务配置（从环境变量注入，代码里不出现 secret） ============

# --- LLM Provider 配置 ---
# 支持任意 OpenAI 兼容 API：
#   OpenAI    → 留空 base_url 即可
#   DeepSeek  → https://api.deepseek.com/v1
#   Moonshot  → https://api.moonshot.cn/v1
#   本地 Ollama → http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=sk-xxx-your-key-here
LLM_MODEL=gpt-4o-mini

# --- LLM 客户端（连接池 + 重试，一般用默认值即可） ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONNECTIONS=100          # 连接池并发上限
LLM_MAX_KEEPALIVE_CONNECTIONS=20 # 空闲保活连接上限
LLM_MAX_RETRIES=3                # 429/5xx/网络错误重试次数
LLM_RETRY_BASE_DELAY=1           # 退避基数秒：1s → 2s → 4s
LLM_RETRY_MAX_DELAY=8            # 退避上限秒，防止雪崩

# --- 服务配置 ---
APP_PORT=8000
APP_ENV=dev

# --- 数据库（PostgreSQL + pgvector，本地用 docker compose up -d 启动） ---
DATABASE_URL=postgresql+psycopg://llmqa:llmqa_dev_only@localhost:5432/llmqa

# --- Embedding（RAG 向量化） ---
# provider: auto | local | api | mock
#   auto → 有 API key 用 api；否则本地模型（fastembed 首次自动下载 ~90MB）；再否则 mock
#   local → 本地 BAAI/bge-small-zh-v1.5（中文检索质量高，无需 key）
#   api   → 任意 OpenAI 兼容 embedding（OpenAI/SiliconFlow/智谱等）
#   mock  → 确定性哈希向量（无依赖兜底，检索基于词重叠，效果弱）
EMBEDDING_PROVIDER=auto
EMBEDDING_DIM=512
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# --- RAG 检索参数 ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4

# --- MCP（外部工具接入，可选） ---
# 留空：Agent 只使用本地工具（知识库 / 计算器 / 香港时间）。
# 开启 MCP 时，前端还需勾选「使用已配置 MCP 工具」或请求中传 use_mcp=true。
# 每个 server 必须显式声明 allowed_tools；不要把任意命令、URL 或 token 暴露给客户端。
#
# 本地演示 server（用于验证接入；可运行 python -m app.demo_mcp_server）：
# MCP_SERVERS_JSON='{"demo":{"transport":"stdio","command":"python","args":["-m","app.demo_mcp_server"],"allowed_tools":["lookup_demo_policy"]}}'
#
# Streamable HTTP server 示例（将 token 通过部署平台的 secret 管理；仅允许需要的工具）：
# MCP_SERVERS_JSON='{"inventory":{"transport":"streamable_http","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer replace-me"},"allowed_tools":["lookup_inventory"],"timeout_seconds":20}}'
MCP_SERVERS_JSON=
